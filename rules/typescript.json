{
    "name": "TypeScript",
    "description": "TypeScript source and common TypeScript project files.",
    "exclude_dirs": [
        ".git",
        "node_modules",
        "dist",
        "build",
        "coverage",
        ".next",
        ".nuxt",
        ".cache",
        ".parcel-cache",
        ".turbo"
    ],
    "exclude_files": [
        "*.tsbuildinfo"
    ],
    "content_extensions": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts"
    ],
    "content_files": [
        "package.json",
        "tsconfig.json",
        "tsconfig.app.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "eslint.config.ts",
        "README.md"
    ]
}