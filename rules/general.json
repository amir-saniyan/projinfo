{
    "name": "General",
    "description": "General-purpose project rules for mixed-language projects.",
    "exclude_dirs": [
        ".git",
        ".svn",
        ".hg",
        ".idea",
        ".vscode",
        "node_modules",
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".tox",
        ".venv",
        "venv",
        "env",
        "target",
        "build",
        "dist",
        "out",
        "bin",
        "obj",
        "coverage",
        ".cache",
        ".temp",
        "tmp"
    ],
    "exclude_files": [
        "*.pyc",
        "*.pyo",
        "*.o",
        "*.obj",
        "*.a",
        "*.so",
        "*.dll",
        "*.dylib",
        "*.exe",
        "*.class",
        "*.jar",
        "*.tmp",
        "*.temp",
        "*.log",
        "*.bak",
        "*.swp",
        "*.swo",
        "*.map"
    ],
    "content_extensions": [
        ".c",
        ".h",
        ".cc",
        ".cpp",
        ".cxx",
        ".hpp",
        ".hxx",
        ".cs",
        ".java",
        ".kt",
        ".kts",
        ".rs",
        ".go",
        ".py",
        ".pyi",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".sass",
        ".less",
        ".sql",
        ".sh",
        ".bash",
        ".zsh",
        ".fish",
        ".php",
        ".rb",
        ".swift",
        ".dart",
        ".lua",
        ".r"
    ],
    "content_files": [
        "README",
        "README.md",
        "README.txt",
        "LICENSE",
        "Makefile",
        "CMakeLists.txt",
        "Dockerfile",
        "docker-compose.yml",
        "docker-compose.yaml",
        "package.json",
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "Cargo.toml",
        "Cargo.lock",
        "go.mod",
        "go.sum",
        "pyproject.toml",
        "requirements.txt",
        "requirements-dev.txt",
        "setup.py",
        "setup.cfg",
        "tsconfig.json",
        "tsconfig.app.json",
        "tsconfig.node.json",
        ".gitignore"
    ]
}