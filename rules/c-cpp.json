{
    "name": "C/C++",
    "description": "C and C++ source files and common project files.",
    "exclude_dirs": [
        ".git",
        "build",
        "dist",
        "out",
        "bin",
        "obj",
        "cmake-build-debug",
        "cmake-build-release"
    ],
